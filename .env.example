# Eviko, üç moddan biriyle çalışır. Öncelik sırası: Gemini > Claude > Demo.

# --- Seçenek 1: ÜCRETSİZ — Google Gemini (önerilir) ---
# Ücretsiz API anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsiyonel model (varsayılan: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# --- Seçenek 2: Claude (Anthropic, ücretli) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Hiçbiri girilmezse uygulama DEMO modunda örnek verilerle çalışır.

# Sunucu portu (opsiyonel, varsayılan 3000)
PORT=3000
